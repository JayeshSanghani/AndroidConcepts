3) Inheritance
-Deriving a new class from already existing class.
🌍 Real-World Example
-Types:
    ------------------------------------------------------------------------------------------------------
    Single: One child → one parent
        SavingsAccount extends Account
        open class Account(val accountNumber: String) {
            fun deposit(amount: Double) {}
        }
        class SavingsAccount(accountNumber: String) : Account(accountNumber)

    ------------------------------------------------------------------------------------------------------
    Multilevel:Chain inheritance (A → B → C)
        Account → SavingsAccount → PremiumSavingsAccount
        open class Account(val accountNumber: String)
        open class SavingsAccount(accountNumber: String) : Account(accountNumber)
        class PremiumSavingsAccount(accountNumber: String) : SavingsAccount(accountNumber)

    ------------------------------------------------------------------------------------------------------
    Hierarchical: One parent → multiple children
        Account → SavingsAccount, CurrentAccount, LoanAccount
        open class Account(val accountNumber: String)

        class SavingsAccount(accountNumber: String) : Account(accountNumber)
        class CurrentAccount(accountNumber: String) : Account(accountNumber)
        class LoanAccount(accountNumber: String) : Account(accountNumber)

    ------------------------------------------------------------------------------------------------------
    Multiple(via interfaces): One class → multiple parents (interfaces)
        Account supports Interest + Loan features
        interface Interest {
            fun calculateInterest()
        }

        interface Loan {
            fun applyLoan()
        }

        class SmartAccount : Interest, Loan {
            override fun calculateInterest() {}
            override fun applyLoan() {}
        }

    ------------------------------------------------------------------------------------------------------
    Hybrid(combination of above): Combination of multiple + hierarchical
        Account → SavingsAccount
        SavingsAccount + Loan → SmartAccount
        open class Account

        open class SavingsAccount : Account()

        interface Loan {
            fun applyLoan()
        }

        class SmartAccount : SavingsAccount(), Loan {
            override fun applyLoan() {}
        }

