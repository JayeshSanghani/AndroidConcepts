fun firstNonRepeatingChar(str: String): Char? {
    val map = mutableMapOf<Char, Int>()

    for (c in str) {
        map[c] = map.getOrDefault(c, 0) + 1
    }

    for (c in str) {
        if (map[c] == 1) return c
    }
    return null
}

