-->Check Palindrome string (Without Using Reverse)
Input: madam
Output: true

Time: O(n) | Space: O(1)
------------------------------------------------------------------------------------------
fun isPalindrome(str: String): Boolean {
    var start = 0
    var end = str.length - 1

    while (start < end) {
        if (str[start] != str[end]) return false
        start++
        end--
    }
    return true
}


