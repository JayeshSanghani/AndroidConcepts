-->Two strings are called anagrams if they contain the same characters with the same frequency, but possibly in a different order.
   Input
   s1 = "listen"
   s2 = "silent"

   Output
   true

   Complexity
   Time: O(n)
   Space: O(1)
------------------------------------------------------------------------------------------
fun areAnagrams(s1: String, s2: String): Boolean {
    if (s1.length != s2.length) return false

    val freq = IntArray(26)

    for (i in s1.indices) {
        freq[s1[i] - 'a']++
        freq[s2[i] - 'a']--
    }

    return freq.all { it == 0 }
}

fun main() {
    val s1 = "listen"
    val s2 = "silent"
    println(areAnagrams(s1, s2))
}



