--> Given a string s, find the length of the longest substring without repeating characters.

Input: "abcabcbb"
Output: 3
Explanation: "abc"

Index:  0 1 2 3 4 5 6 7
Char :  a b c a b c b b

Substring starting at index 0:
"a" → unique ✅ (length = 1)
"ab" → unique ✅ (length = 2)
"abc" → unique ✅ (length = 3)
"abca" → ❌ a repeated → stop here
➡ Longest so far = "abc" (length 3)
------------------------------------------------------------------------------------------
fun longestUniqueSubstring(s: String): String {
    val charSet = HashSet<Char>()
    var left = 0
    var maxLength = 0
    var startIndex = 0

    for (right in s.indices) {
        while (charSet.contains(s[right])) {
            charSet.remove(s[left])
            left++
        }
        charSet.add(s[right])

        if (right - left + 1 > maxLength) {
            maxLength = right - left + 1
            startIndex = left
        }
    }
    return s.substring(startIndex, startIndex + maxLength)
}

fun main() {
    val input = "abcabcbb"
    val result = longestUniqueSubstring(input)

    println("Longest unique substring: \"$result\"")
    println("Length: ${result.length}")
}

