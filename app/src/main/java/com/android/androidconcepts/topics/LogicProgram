-->Merge K Sorted Arrays
[[1,4,7], [2,5,8], [3,6,9]]
[1,2,3,4,5,6,7,8,9]

Min Heap ensures sorted order
 O(N log K)
------------------------------------------------------------------------------------------
fun mergeKArrays(arrays: List<IntArray>): IntArray {
    val pq = PriorityQueue<Int>()
    arrays.forEach { it.forEach { num -> pq.add(num) } }

    return IntArray(pq.size) { pq.poll() }
}

